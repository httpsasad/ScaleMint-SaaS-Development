# ScaleMint Environment Configuration Template
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual secret keys or production credentials to git.

# -----------------------------------------------------------------------------
# Public Application Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Python FastAPI Backend Integration
# -----------------------------------------------------------------------------
# Base URL for the ScaleMint FastAPI backend service.
# Default for local backend development: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Supabase PostgreSQL Configuration
# -----------------------------------------------------------------------------
# Public Supabase credentials safe for client browser runtime
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-placeholder

# -----------------------------------------------------------------------------
# Server-Only / Backend Privileged Credentials
# WARNING: NEVER prefix these with NEXT_PUBLIC_. Keep strictly on the server / FastAPI service.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
DATABASE_URL=postgresql://postgres:password@localhost:5432/scalemint_db

# -----------------------------------------------------------------------------
# Automation Worker & Integration Mode (Stage 5)
# -----------------------------------------------------------------------------
# Active integration mode: 'mock' (default for development/testing) or 'live'
INTEGRATION_MODE=mock

# Background Worker Settings
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10
WORKER_MAX_RETRIES=5
WORKER_AUTH_TOKEN=your-internal-worker-secret-token

# Optional: External Queue / Redis Broker (if using distributed queue)
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Server-Side Secrets & Credential Encryption
# -----------------------------------------------------------------------------
# 32-byte hex key for encrypting portal tokens and credentials at rest
SECRETS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# -----------------------------------------------------------------------------
# External Advertising Portal: TikTok Marketing API (Server-Only)
# WARNING: NEVER expose these to the browser or commit real secrets.
# -----------------------------------------------------------------------------
TIKTOK_API_ENDPOINT=https://business-api.tiktok.com/open_api/v1.3
TIKTOK_APP_ID=your-tiktok-app-id-placeholder
TIKTOK_APP_SECRET=your-tiktok-app-secret-placeholder
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token-placeholder
TIKTOK_BUSINESS_CENTER_ID=your-tiktok-bc-id-placeholder
